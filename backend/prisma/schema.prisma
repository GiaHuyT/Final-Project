// --- CẤU HÌNH KẾT NỐI ---
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- NHÓM NGƯỜI DÙNG & TÀI KHOẢN ---
model User {
  id                Int      @id @default(autoincrement())
  username          String   // Tên hiển thị trên hệ thống
  email             String?  @unique // Có thể dùng đăng nhập, để trống nếu dùng phone
  phonenumber             String?  @unique // Có thể dùng đăng nhập, để trống nếu dùng email
  password          String

  avatar            String?
  roles             Role[]   @default([CUSTOMER])
  isApprovedVendor      Boolean  @default(false)
  vendorRequestPending  Boolean  @default(false)
  isApprovedDriver      Boolean  @default(false)
  driverRequestPending  Boolean  @default(false)
  pendingRequestType    String?
  isActive          Boolean  @default(true)
  lockReason        String?
  lockedRoles       Role[]   @default([])
  roleLockReasons   Json?
  lockUntil         DateTime?
  createdAt         DateTime @default(now())
  resetToken        String?   // token reset password
  resetTokenExpires DateTime? // 
  refreshToken      String?   // 

  // Quan hệ đối xứng
  addresses         Address[]
  products          Product[]
  orders            Order[]
  auctions          Auction[]       @relation("VendorAuctions")
  wonAuctions       Auction[]       @relation("WinnerAuctions")
  wonAuctionItems   AuctionItem[]   @relation("WinnerAuctionItems")
  bids              AuctionBid[]    
  serviceProfiles   ServiceProfile? 
  reviews           Review[]
  notifications     Notification[]
  favorites         Favorite[]      
  conversations     Conversation[]   @relation("UserConversations")
  messages          Message[]
  cart              Cart?
  auctionRegistrations AuctionRegistration[]
  
  // Rides
  customerRides     DriverBooking[]  @relation("CustomerRides")
  driverRides       DriverBooking[]  @relation("DriverRides")
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
  DRIVER
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  title         String   // e.g., Nhà riêng, Công ty
  receiverName  String
  receiverPhone String
  detail        String   // Tên đường, số nhà
  province      String
  district      String
  ward          String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// --- NHÓM MASTER DATA (HÃNG & DÒNG XE) ---
model Brand {
  id      Int        @id @default(autoincrement())
  name    String     @unique
  models  CarModel[]
}

model CarModel {
  id        Int    @id @default(autoincrement())
  name      String
  brandId   Int
  brand     Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants  CarVariant[]

  @@unique([name, brandId])
}

model CarVariant {
  id        Int      @id @default(autoincrement())
  name      String
  modelId   Int
  carModel  CarModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([name, modelId])
}

// --- NHÓM SẢN PHẨM & MUA BÁN ---
model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  status      Boolean  @default(true)
  imageUrl    String?
  vendorId    Int
  vendor      User     @relation(fields: [vendorId], references: [id])
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  
  // Thông tin xe bổ sung
  brand             String?
  modelName         String?
  variant           String?
  year              Int?
  condition         String?   @default("Xe mới")
  licensePlate      String?
  mileage           Float?
  conditionDetail   String?
  usageTime         String?
  maintenanceHistory String?
  wearAndTear       String?
  vehicleHistory    String?
  remainingWarranty String?
  color             String?
  bodyType          String?
  
  // Thông số động cơ
  fuelType          String?
  engineCapacity    String?
  maxPower          String?
  maxTorque         String?
  transmission      String?
  driveType         String?
  
  // Thông số kích thước & trọng lượng
  length            Float?
  width             Float?
  height            Float?
  wheelbase         Float?
  groundClearance   Float?
  curbWeight        Float?
  
  // Nhiên liệu
  fuelTankCapacity  Float?
  avgFuelConsumption Float?

  // Tiện nghi
  autoConditioning  Boolean? @default(false)
  infotainment      Boolean? @default(false)
  appleCarplay      Boolean? @default(false)
  
  electricSeats     Boolean? @default(false)
  smartKey          Boolean? @default(false)
  rearAirCon        Boolean? @default(false)
  wirelessCharger   Boolean? @default(false)
  cruiseControl     Boolean? @default(false)
  camera360         Boolean? @default(false)

  hud               Boolean? @default(false)
  heatedSeats       Boolean? @default(false)
  sunroof           Boolean? @default(false)
  premiumAudio      Boolean? @default(false)

  // An toàn
  airbags           Int?     @default(0)
  abs               Boolean? @default(false)
  ebd               Boolean? @default(false)
  ba                Boolean? @default(false)
  esp               Boolean? @default(false)
  tcs               Boolean? @default(false)
  hsa               Boolean? @default(false)
  rearSensor        Boolean? @default(false)
  aeb               Boolean? @default(false)
  lka               Boolean? @default(false)
  bsm               Boolean? @default(false)
  acc               Boolean? @default(false)
  
  depositEndsAt     DateTime?

  images            ProductImage[]
  colorVariants     ProductColorVariant[]
  orderItems        OrderItem[]
  favorites         Favorite[]
  cartItems         CartItem[]
  auctionItems      AuctionItem[]
  reviews           Review[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model ProductColorVariant {
  id        Int                   @id @default(autoincrement())
  productId Int
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  images    ProductVariantImage[]
}

model ProductVariantImage {
  id        Int                 @id @default(autoincrement())
  variantId Int
  variant   ProductColorVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime            @default(now())
}


// --- NHÓM ĐẤU GIÁ ---
enum AuctionType {
  OFFLINE
  LIVESTREAM
}

model Auction {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  startPrice     Float
  currentPrice   Float?
  bidStep        Float    @default(0) // Bước nhảy giá
  type           AuctionType @default(OFFLINE)
  
  // Thông số Livestream
  streamUrl      String? // Nếu nhúng YT/FB
  streamKey      String? // Nếu tự Live qua WebRTC
  
  startTime      DateTime
  endTime        DateTime
  
  // Trạng thái: PENDING, ACTIVE, WAITING_PAYMENT (chờ cọc), COMPLETED, CANCELLED
  status         String   @default("PENDING") 
  
  currentActiveItemId Int? // Dành cho Livestream: ID của AuctionItem đang được đấu giá
  breakEndsAt         DateTime? // Thời gian kết thúc nghỉ giải lao 1 phút
  
  vendorId       Int
  vendor         User     @relation("VendorAuctions", fields: [vendorId], references: [id])
  winnerId       Int?     
  winner         User?    @relation("WinnerAuctions", fields: [winnerId], references: [id])
  
  bids           AuctionBid[]
  transactions   Transaction[]
  items          AuctionItem[]
  registrations  AuctionRegistration[]
}

model AuctionItem {
  id          Int      @id @default(autoincrement())
  auctionId   Int
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  orderIndex  Int      @default(0) // Thứ tự xuất hiện trong livestream
  
  startPrice    Float?
  currentPrice  Float?
  bidStep       Float?
  itemDescription String?
  status        String   @default("PENDING") // PENDING, ACTIVE, SOLD, PASSED
  winnerId      Int?
  winner        User?    @relation("WinnerAuctionItems", fields: [winnerId], references: [id])
  
  bids          AuctionBid[]
}

model AuctionBid {
  id          Int      @id @default(autoincrement())
  auctionId   Int
  auction     Auction  @relation(fields: [auctionId], references: [id])
  auctionItemId Int?
  auctionItem   AuctionItem? @relation(fields: [auctionItemId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  bidAmount   Float
  createdAt   DateTime @default(now())
}

model AuctionRegistration {
  id          Int      @id @default(autoincrement())
  auctionId   Int
  auction     Auction  @relation(fields: [auctionId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  status      String   @default("REGISTERED") // REGISTERED, DEPOSIT_PAID, etc.
  createdAt   DateTime @default(now())

  // Đảm bảo user chỉ được đăng ký 1 lần cho 1 phiên đấu giá
  @@unique([auctionId, userId])
}

// --- NHÓM DỊCH VỤ ---
model ServiceProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  serviceType String
  experience  String?
  isApproved  Boolean  @default(false)
  repairs     RepairService[]
  repairCapacities RepairCapacity[]
  maintenanceServices MaintenanceService[]
  driverRentalServices DriverRentalService[]
}



model RepairService {
  id          Int      @id @default(autoincrement())
  profileId   Int
  profile     ServiceProfile @relation(fields: [profileId], references: [id])
  name        String
  description String?
  price       Float    @default(0)
  status      String   @default("Hoạt động")
}

model RepairCapacity {
  id              Int      @id @default(autoincrement())
  profileId       Int
  profile         ServiceProfile @relation(fields: [profileId], references: [id])
  name            String   // Tiêu đề năng lực (Ví dụ: Chuyên đại tu động cơ)
  specialty       String   // e.g., Động cơ, Hệ thống điện, Mâm last, v.v.
  experienceYears Int      @default(0)
  vehicleTypes    String   // e.g., "Xe tải, Xe con"
  province        String?
  district        String?
  contactPhone    String?
  contactName     String?
  description     String?
  imageUrl        String?
  imageUrls       String[] @default([])
  status          String   @default("Hoạt động")
  createdAt       DateTime @default(now())
}

model MaintenanceService {
  id              Int      @id @default(autoincrement())
  profileId       Int
  profile         ServiceProfile @relation(fields: [profileId], references: [id])
  name            String
  description     String?
  price           Float    @default(0)
  status          String   @default("Hoạt động")
  createdAt       DateTime @default(now())
}

model DriverRentalService {
  id              Int      @id @default(autoincrement())
  profileId       Int
  profile         ServiceProfile @relation(fields: [profileId], references: [id])
  name            String
  dob             String?
  experienceYears Int      @default(0)
  pricePerKm      Float    @default(0)
  avatarUrl       String?
  licenseFrontUrl String?
  licenseBackUrl  String?
  idCardFrontUrl  String?
  idCardBackUrl   String?
  criminalRecordUrl String?
  status          String   @default("Hoạt động")
  createdAt       DateTime @default(now())

  // 1. Thông tin cá nhân mới
  idCardNumber    String?
  phoneNumber     String?
  email           String?
  currentAddress  String?

  // 2. Thông tin bằng lái
  licenseType     String?
  licenseNumber   String?
  licenseIssueDate String?
  licenseExpiryDate String?
  hasServiceExperience Boolean @default(false)

  // 3. Lý lịch & An toàn
  hasCriminalRecord Boolean @default(false)
  healthConditionValid Boolean @default(true)

  // 4. Khu vực hoạt động
  operatingCities String[] @default([])
  workType        String?  // Full-time / Part-time
  workShifts      String[] @default([]) // Sáng, Chiều, Đêm

  // 5. Thông tin thanh toán
  bankAccountNumber String?
  bankName        String?
  bankAccountName String?

  // 6. Thiết bị & kết nối
  hasSmartphone   Boolean @default(true)
  osPlatform      String? // Android / iOS
  hasMobileData   Boolean @default(true)

  // 8. Điều khoản & cam kết
  agreedToTerms   Boolean @default(false)
  agreedToNoAlcohol Boolean @default(false)
  agreedToResponsibility Boolean @default(false)

  // 9. Thông tin thêm (Optional)
  bio             String?
  languages       String[] @default([])
}

model DriverBooking {
  id              Int      @id @default(autoincrement())
  
  customerId      Int
  customer        User     @relation("CustomerRides", fields: [customerId], references: [id])
  
  driverId        Int?
  driver          User?    @relation("DriverRides", fields: [driverId], references: [id])
  
  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  
  dropoffAddress  String
  dropoffLat      Float
  dropoffLng      Float
  
  distanceKm      Float
  totalPrice      Float
  
  carType         String?
  carBrand        String?
  transmission    String?
  licensePlate    String?
  contactPhone    String?
  requiredLicense String?
  
  status          String   @default("PENDING") // PENDING, ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- NHÓM GIAO DỊCH & TƯƠNG TÁC ---
model Order {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    User     @relation(fields: [customerId], references: [id])
  totalPrice  Float
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  items       OrderItem[]
  transactions Transaction[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  content   String
  rating    Int
  
  targetType String  @default("VENDOR") // "VENDOR" or "PRODUCT"
  targetId  Int
  
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Favorite {
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  @@id([userId, productId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @default(SYSTEM)
  content   String
  link      String?          // URL để điều hướng khi click
  metadata  Json?            // Chứa các ID liên quan (orderId, auctionId...)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

// --- NHÓM TRÒ CHUYỆN (CHAT) ---
model Conversation {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  participants User[]    @relation("UserConversations")
  messages     Message[]
  productId    Int?      // Ngữ cảnh tùy chọn (đang hỏi về sản phẩm nào)
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id])
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  createdAt      DateTime     @default(now())
  isRead         Boolean      @default(false)
}

enum NotificationType {
  ORDER
  AUCTION
  SYSTEM
  PROMOTION
  REVIEW
  CHAT
}

// --- GIỎ HÀNG (CART) ---
model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Đảm bảo mỗi sản phẩm chỉ xuất hiện 1 dòng trong 1 giỏ hàng: nếu thêm trùng thì cộng dồn quantity
  @@unique([cartId, productId])
}

// --- GIAO DỊCH THANH TOÁN (TRANSACTION) ---
model Transaction {
  id            Int      @id @default(autoincrement()) // This will be the orderCode for PayOS
  orderId       Int?
  order         Order?   @relation(fields: [orderId], references: [id])
  auctionId     Int?
  auction       Auction? @relation(fields: [auctionId], references: [id])
  amount        Float
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- YÊU CẦU HỖ TRỢ CHI TIẾT ---
model ContactRequest {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String
  email        String
  subject      String
  otherSubject String?
  message      String
  status       String   @default("PENDING") // PENDING, RESOLVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
